# ============================================================================
# Tablero — variables de entorno
#
# Copiar a `.env` en la raíz (y/o a `apps/api/.env`) antes de arrancar.
#   cp .env.example .env
# El archivo `.env` está en .gitignore: no se versiona.
# ============================================================================

# --- Base de datos (PostgreSQL de docker/docker-compose.yml) -----------------
# El contenedor publica 5433 porque en este equipo el 5432 lo ocupa un
# PostgreSQL 17 nativo (servicio postgresql-x64-17). Si no tenés un Postgres
# nativo, podés publicar el contenedor en 5432 y usar el puerto 5432 acá.
DATABASE_URL="postgresql://tablero:tablero@localhost:5433/tablero?schema=public"

# --- API (Fastify) -----------------------------------------------------------
# Puerto de la API. La web de desarrollo usa 5173; no cambiar a ese puerto.
PORT=8787
NODE_ENV=development

# Origen de la aplicación web. Se usa para CORS y para la comprobación CSRF
# (Origin/Referer de toda petición mutante debe coincidir con este valor).
APP_ORIGIN=http://localhost:5173

# Orígenes adicionales permitidos (CORS + CSRF), separados por coma. Vacío = ninguno.
ALLOWED_ORIGINS=

# Secreto de aplicación (>=32 caracteres en producción). Reservado para cookies
# firmadas y derivación de tokens; las sesiones se guardan hasheadas en la base,
# así que hoy no se usa para firmar nada.
SESSION_SECRET="dev-only-cambiame-por-un-secreto-de-al-menos-32-caracteres"

# --- Almacenamiento de objetos (MinIO en desarrollo) -------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tablero
S3_SECRET_KEY=tablero123
S3_BUCKET=tablero
S3_REGION=us-east-1

# Tamaño máximo de subida en MB (endpoint multipart de assets).
MAX_UPLOAD_MB=500
