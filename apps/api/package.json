{
  "name": "@tablero/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST + tiempo real (Fastify, Prisma, Hocuspocus) de Tablero",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "seed:templates": "tsx scripts/seed-templates.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:assets": "tsx scripts/smoke-assets.ts",
    "smoke:colaboracion": "tsx scripts/smoke-colaboracion.ts",
    "smoke:collab": "tsx scripts/smoke-collab.ts",
    "smoke:productividad": "tsx scripts/smoke-productividad.ts",
    "smoke:upgrade": "node scripts/smoke-upgrade.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@hocuspocus/server": "^2.15.3",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^5.22.0",
    "@tablero/shared": "workspace:*",
    "fastify": "~4.28.1",
    "ipaddr.js": "^2.5.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.0",
    "yjs": "^13.6.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.3",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.12",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
