// Modelo de datos de Tablero (PostgreSQL).
//
// El contenido del lienzo vive en Yjs (`BoardDocument.yjsState`); acá está todo
// lo relacional: usuarios, árbol de tableros, permisos, assets y búsqueda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardRole {
  viewer
  commenter
  editor
}

enum AssetType {
  image
  video
  audio
  file
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  passwordHash String
  settings     Json     @default("{}")
  /// Token personal de captura: 32 bytes aleatorios en base64url (no un cuid
  /// predecible). Se genera en `createUserWithRootBoard` y se rota con
  /// `POST /api/settings/capture-token`; sin `@default` para que ningún alta
  /// pueda quedarse con uno generado por la librería.
  captureToken String   @unique
  createdAt    DateTime @default(now())

  boards        Board[]        @relation("BoardOwner")
  sessions      Session[]
  comments      Comment[]
  assets        Asset[]
  notifications Notification[] @relation("NotificationRecipient")
  templates     Template[]
  /// Membresías en tableros ajenos (fase 5).
  memberships   BoardMember[]  @relation("BoardMemberUser")
  membersInvited BoardMember[] @relation("BoardMemberInviter")
  invitations   Invitation[]   @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  activities    Activity[]
  actedNotifications Notification[] @relation("NotificationActor")

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// sha256 hex del token de sesión (el token en claro nunca se guarda).
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Board {
  id                    String    @id @default(cuid())
  ownerId               String
  parentBoardId         String?
  title                 String    @default("Tablero sin título")
  icon                  String?
  color                 String?
  /// Asset usado como portada. Sin FK: la integridad se valida en la API.
  coverImageId          String?
  isTemplate            Boolean   @default(false)
  /// Slug inadvertible de la publicación (12 caracteres base58).
  publishedSlug         String?   @unique
  /// argon2 de la contraseña de la publicación (null = sin contraseña).
  publishedPasswordHash String?
  /// Publicación (fase 5): momento en que se publicó (null = no publicado).
  publishedAt           DateTime?
  /// La vista pública navega los subtableros (solo lectura).
  publicIncludeSubBoards Boolean  @default(false)
  trashedAt             DateTime?
  /// Momento en que el usuario marcó el tablero como favorito (null = no lo es).
  favoriteAt            DateTime?
  /// Tablero «Sin ordenar»: bandeja de entrada de la cuenta, oculta del listado normal.
  isUnsorted            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner       User           @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parent      Board?         @relation("BoardTree", fields: [parentBoardId], references: [id], onDelete: SetNull)
  children    Board[]        @relation("BoardTree")
  document    BoardDocument?
  versions    BoardVersion[]
  comments    Comment[]
  templates   Template[]
  searchIndex SearchIndex[]
  members     BoardMember[]
  invitations Invitation[]
  activities  Activity[]
  notifications Notification[]

  @@index([ownerId])
  @@index([parentBoardId])
  @@index([trashedAt])
  @@index([favoriteAt])
  @@index([isTemplate])
  @@index([publishedAt])
}

/// Estado Yjs serializado (1:1 con el tablero).
model BoardDocument {
  boardId   String   @id
  yjsState  Bytes
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String    @id @default(cuid())
  ownerId      String
  type         AssetType
  mime         String
  size         Int
  /// sha256 hex del contenido: permite reutilizar el archivo ya subido (dedupe).
  sha256       String?
  /// Tablero al que el usuario asoció el archivo al subirlo. Sin FK (igual que
  /// `Board.coverImageId`): la API valida el acceso antes de usarlo.
  boardId      String?
  storageKey   String    @unique
  width        Int?
  height       Int?
  duration     Float?
  thumbnailKey String?
  originalName String
  createdAt    DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, sha256])
  @@index([boardId])
  @@index([type])
}

/// Caché de metadatos Open Graph de enlaces externos (clave: URL).
model LinkPreview {
  url         String   @id
  title       String?
  description String?
  imageUrl    String?
  faviconUrl  String?
  siteName    String?
  embedType   String   @default("generic")
  fetchedAt   DateTime @default(now())

  @@index([fetchedAt])
}

/// Miembro de un tablero (fase 5). El dueño no tiene fila: su rol sale de
/// `Board.ownerId`. La herencia en subtableros la resuelve `lib/access.ts`.
model BoardMember {
  id          String    @id @default(cuid())
  boardId     String
  userId      String
  role        BoardRole
  /// Quién concedió el acceso (null si lo creó la API del dueño o un script).
  invitedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User  @relation("BoardMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("BoardMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
  @@index([boardId, role])
}

/// Invitación por email con caducidad (fase 5). Al aceptarla nace la fila de
/// `BoardMember` y la invitación queda marcada con `acceptedAt`.
model Invitation {
  id           String    @id @default(cuid())
  boardId      String
  email        String
  role         BoardRole @default(viewer)
  /// Token del enlace `/invite/:token` (32 bytes base64url).
  token        String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  invitedById  String
  createdAt    DateTime  @default(now())

  board      Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([email])
  @@index([expiresAt])
}

/// Proyección del hilo de comentarios que vive en el documento Yjs (elemento
/// `comment-pin`). La fuente de verdad es el documento: el hook de persistencia
/// hace upsert de esta tabla con lo que encuentra ahí.
model Comment {
  id              String    @id @default(cuid())
  boardId         String
  /// Elemento del lienzo al que está anclado (null = chincheta suelta).
  elementId       String?
  /// Comentario raíz del hilo si esta fila es una respuesta.
  parentCommentId String?
  authorId        String
  body            String
  /// Posición de la chincheta libre en el lienzo (null si está anclada).
  x               Float?
  y               Float?
  /// Hilo resuelto (null = abierto).
  resolvedAt      DateTime?
  /// Quién resolvió el hilo (id de usuario tal cual vive en el documento).
  resolvedBy      String?
  /// Ids de usuarios mencionados en el comentario.
  mentions        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([boardId])
  @@index([elementId])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([boardId, resolvedAt])
}

/// Registro de actividad del tablero. Lo reporta el cliente por lotes
/// (`POST /api/boards/:id/activity`): es un registro para leer, no una
/// frontera de seguridad.
model Activity {
  id          String   @id @default(cuid())
  boardId     String
  userId      String
  action      String
  elementId   String?
  elementType String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
  @@index([boardId, userId])
  @@index([userId, createdAt])
}

/// Notificación de la cuenta (fase 5): menciones, respuestas, tablero
/// compartido y tareas vencidas. `dedupeKey` evita duplicados (una mención por
/// comentario y usuario, una tarea vencida por tarea y día).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// `mention` | `reply` | `comment` | `board-shared` | `task-overdue`.
  kind      String
  boardId   String?
  elementId String?
  actorId   String?
  meta      Json      @default("{}")
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  board Board? @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([boardId])
}

model Template {
  id          String   @id @default(cuid())
  ownerId     String?
  boardId     String
  category    String   @default("general")
  name        String
  description String?
  createdAt   DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([boardId])
  @@index([category])
}

/// Índice de búsqueda por elemento (texto plano). La columna `tsv` la calcula
/// Postgres (`to_tsvector('spanish', text)`, columna generada con índice GIN) y
/// la API solo escribe `text`.
model SearchIndex {
  boardId       String
  elementId     String
  elementType   String
  text          String
  /// Texto normalizado (minúsculas, sin diacríticos) para el respaldo por
  /// subcadena: `reunion` encuentra «Reunión». Lo escribe la API.
  textNorm      String   @default("")
  tsv           Unsupported("tsvector")?
  actualizadoEn DateTime @default(now()) @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([boardId, elementId])
  @@index([elementType])
  @@index([text])
}

/// Instantánea del documento Yjs de un tablero (§7.5 del plan): el historial de
/// versiones. La crea el hook de persistencia con throttle (una cada 10 minutos
/// de actividad) y la poda la retención acotada de `lib/versions.ts`.
model BoardVersion {
  id           String   @id @default(cuid())
  boardId      String
  yjsState     Bytes
  /// Cantidad de elementos y peso del estado: alimentan la previsualización.
  elementCount Int      @default(0)
  sizeBytes    Int      @default(0)
  /// Origen de la instantánea: `auto` (throttle), `manual` o `restore`.
  origin       String   @default("auto")
  createdAt    DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
}

