{
  "manifest_version": 3,
  "name": "Tablero — captura rápida",
  "version": "0.1.0",
  "description": "Manda la página actual (título, URL y selección de texto) a «Sin ordenar» en Tablero, con tu token personal.",
  "action": {
    "default_title": "Capturar esta página en Tablero",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
