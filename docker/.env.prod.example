# Tablero en producción — configuración de `docker-compose.prod.yml`.
#
#   cp docker/.env.prod.example docker/.env.prod   # y editarla
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d
#
# Este archivo NO se versiona (está en .gitignore). Los valores de abajo son de
# ejemplo: reemplazá todo antes de exponerlo a internet.

# --- Dominio ----------------------------------------------------------------
# El origen público de Tablero. Tiene que coincidir con APP_ORIGIN (la API lo
# deriva de acá). Sin dominio propio: un subdominio de DuckDNS free sirve
# (nombre.duckdns.org apuntando a la IP de la VM).
SITE_ADDRESS=mi-tablero.duckdns.org

# Correo para los avisos de Let's Encrypt. Opcional.
ACME_EMAIL=

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=tablero
POSTGRES_PASSWORD=cambiame-por-una-larga-aleatoria
POSTGRES_DB=tablero

# --- Sesión -----------------------------------------------------------------
# Firma de cookies y derivación de tokens. Mínimo 32 caracteres: en producción
# la API se niega a arrancar con menos. Generalo con:
#   openssl rand -base64 48
SESSION_SECRET=cambiame-por-48-bytes-aleatorios-de-openSSL-aqui

# --- Cloudflare R2 (archivos) ------------------------------------------------
# El bucket se crea desde el panel: Cloudflare → Storage & Databases → R2 →
# Create bucket. Las credenciales salen de R2 → Manage R2 API Tokens →
# Object Read & Write.
#
# La API entrega al navegador URLs firmadas de 15 minutos que apuntan al
# endpoint de R2, así que el bucket puede (y debe) ser privado: es la firma la
# que da acceso, no el bucket.
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tablero

# --- Archivos ----------------------------------------------------------------
# Tope de subida por archivo, en MB.
MAX_UPLOAD_MB=500

# --- Geocodificación ---------------------------------------------------------
# Identificación ante Nominatim, que exige un User-Agent propio.
GEOCODE_USER_AGENT=TableroBot/0.1 (+https://github.com/asormar/tablero)
