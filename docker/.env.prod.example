# Tablero en producción — configuración de `docker-compose.prod.yml`.
#
#   cp docker/.env.prod.example docker/.env.prod   # y editarla
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d
#
# (`docker/provision.sh` ya hace la copia y genera SESSION_SECRET y
# POSTGRES_PASSWORD; sólo quedan el dominio y los datos de R2.)
#
# Este archivo NO se versiona (está en .gitignore). Los valores de abajo son de
# ejemplo: reemplaza todo antes de exponerlo a internet.

# --- Dominio ----------------------------------------------------------------
# El origen público de Tablero. Tiene que coincidir con APP_ORIGIN (la API lo
# deriva de aquí). Sin dominio propio: un subdominio de DuckDNS free sirve
# (nombre.duckdns.org apuntando a la IP de la VM).
SITE_ADDRESS=mi-tablero.duckdns.org

# Correo para los avisos de Let's Encrypt. Opcional.
ACME_EMAIL=

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=tablero
POSTGRES_PASSWORD=cambiame-por-una-larga-aleatoria
POSTGRES_DB=tablero

# --- Sesión -----------------------------------------------------------------
# Firma de cookies y derivación de tokens. Mínimo 32 caracteres: en producción
# la API se niega a arrancar con menos. Genéralo con:
#   openssl rand -base64 48
SESSION_SECRET=cambiame-por-48-bytes-aleatorios-de-openSSL-aqui

# --- Cloudflare R2 (archivos y copias de seguridad) --------------------------
# El bucket se crea desde el panel: Cloudflare → Storage & Databases → R2 →
# Create bucket. Las credenciales salen de R2 → Manage R2 API Tokens →
# Object Read & Write.
#
# La API entrega al navegador URLs firmadas de 15 minutos que apuntan al
# endpoint de R2, así que el bucket puede (y debe) ser privado: es la firma la
# que da acceso, no el bucket. Las copias de seguridad (docker/backup.sh) van al
# mismo bucket, bajo el prefijo `backups/`.
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tablero

# --- Copias de seguridad -----------------------------------------------------
# Días que se conservan las copias de `backups/` en R2. Lo aplica la regla de
# caducidad que crea `apps/api/scripts/r2-setup.ts` (ver docs/deploy.md); hay
# que volver a ejecutarlo si se cambia este valor.
BACKUP_RETENTION_DAYS=14

# --- Lastre de memoria (anti-reclamo de Oracle) ------------------------------
# Memoria residente, en MB, que mantiene el contenedor `ballast` para que la VM
# no cuente como ociosa (Oracle exige CPU, red *y memoria* < 20% durante 7 días;
# el 20% de 12 GB son ~2,4 GB). 3000 deja margen. Con 0 se desactiva el lastre.
BALLAST_MB=3000
# Límite del contenedor, en MB: BALLAST_MB más unas decenas de margen. Si subes
# BALLAST_MB, sube también éste (el lastre se recorta solo al límite, no falla).
# BALLAST_LIMIT_MB=3200

# --- Archivos ----------------------------------------------------------------
# Tope de subida por archivo, en MB. 500 es el valor pensado para R2 (10 GB
# gratis en total): bájalo si el almacenamiento va justo.
MAX_UPLOAD_MB=500

# --- Geocodificación ---------------------------------------------------------
# Identificación ante Nominatim, que exige un User-Agent propio.
GEOCODE_USER_AGENT=TableroBot/0.1 (+https://github.com/asormar/tablero)
